---
import Base from '../layouts/Base.astro';
import Contact from '../components/Contact.astro';
import Cases from '../components/Cases.astro';
import { services, bySlug, type Service } from '../data/services';
import { cases } from '../data/cases';
import { site } from '../data/site';

export function getStaticPaths() {
  return services.map((s) => ({ params: { slug: s.slug }, props: { s } }));
}
const { s } = Astro.props as { s: Service };
const url = `https://ideja-it.hr/${s.slug}/`;
const [what, deeper] = s.sections;
const related = s.related.map(bySlug);
const hasCase = cases.some((c) => c.serviceSlug === s.slug);

const schema = [
  { '@type': 'WebPage', '@id': `${url}#webpage`, url, name: s.title.replace(/ \| IDEJA IT$/, ''), description: s.description, inLanguage: 'hr', about: { '@id': 'https://ideja-it.hr/#business' } },
  { '@type': 'Service', name: s.serviceName, serviceType: s.serviceName, provider: { '@id': 'https://ideja-it.hr/#business' }, areaServed: [{ '@type': 'City', name: 'Zagreb' }, { '@type': 'Country', name: 'Hrvatska' }], description: s.description },
  { '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Početna', item: 'https://ideja-it.hr/' },
    { '@type': 'ListItem', position: 2, name: s.breadcrumb, item: url },
  ] },
  { '@type': 'FAQPage', mainEntity: s.faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) },
];
---
<Base title={s.title} description={s.description} schema={schema}>
  <section class="phero night">
    <div class="wrap phero-grid">
      <div class="phero-copy">
        <nav class="crumbs" aria-label="Putanja"><a href="/">Početna</a><span aria-hidden="true">/</span><span aria-current="page">{s.breadcrumb}</span></nav>
        <p class="kicker">{s.eyebrow}</p>
        <h1 class="display">{s.h1}</h1>
        <p class="lede muted">{s.lead}</p>
        <div class="phero-cta">
          <a class="btn btn-signal" href={`tel:${site.phone}`}>Nazovite {site.phoneDisplay}</a>
          <a class="btn btn-line" href="#kontakt">Pošaljite upit</a>
        </div>
      </div>
      <div class="scope">
        <h2>{what.cards[0].h}</h2>
        <ul>
          {what.cards[0].items?.map((i) => <li><span class="status status-ok" aria-hidden="true"></span>{i}</li>)}
        </ul>
      </div>
    </div>
    <div class="wrap">
      <ul class="pbullets">{s.bullets.map((b) => <li>{b}</li>)}</ul>
    </div>
  </section>

  <section class="paper band">
    <div class="wrap deeper">
      <div class="head">
        <h2 class="display">{deeper.h2}</h2>
        {deeper.intro && <p class="lede">{deeper.intro}</p>}
      </div>
      <div class="deeper-cards">
        {deeper.cards.map((c) => (
          <article>
            <h3>{c.h}</h3>
            {c.p && <p>{c.p}</p>}
            {c.items && <ul>{c.items.map((i) => <li>{i}</li>)}</ul>}
          </article>
        ))}
      </div>
    </div>
  </section>

  {hasCase && (
    <section class="night band">
      <div class="wrap">
        <div class="head"><h2 class="display">Tipičan slučaj</h2></div>
        <Cases limit={[s.slug]} />
      </div>
    </section>
  )}

  <section class="paper band">
    <div class="wrap faq-grid">
      <h2 class="display">{s.faqHeading ?? 'Pitanja koja najčešće dobivamo'}</h2>
      <div class="faq">{s.faq.map((f) => <details><summary>{f.q}</summary><p>{f.a}</p></details>)}</div>
    </div>
  </section>

  <section class="paper related-band">
    <div class="wrap">
      <h2 class="rel-h">Povezane usluge</h2>
      <div class="rel">
        {related.map((r) => (
          <a href={`/${r.slug}/`}><strong>{r.tile.name}</strong><span>{r.tile.line || r.lead.split('. ')[0] + '.'}</span></a>
        ))}
      </div>
    </div>
  </section>

  <Contact heading={s.ctaH} text={s.ctaP} subject={`Upit: ${s.breadcrumb}`} />
</Base>

<style>
  .phero { padding-top: clamp(2.5rem, 6vw, 4.5rem); }
  .phero-grid { display: grid; grid-template-columns: minmax(0, 1.2fr) minmax(0, .8fr); gap: clamp(2rem, 5vw, 4.5rem); align-items: start; }
  .phero-copy { display: grid; gap: 1.3rem; }
  .crumbs { display: flex; gap: .5rem; font-size: .9rem; color: var(--on-night-muted); }
  .crumbs a { color: var(--on-night-muted); text-underline-offset: 3px; }
  .crumbs a:hover { color: var(--on-night); }
  .kicker { color: var(--signal); font-weight: 650; font-stretch: 108%; }
  .phero h1 { font-size: clamp(2.1rem, 1.4rem + 3vw, 3.6rem); }
  .phero-cta { display: flex; flex-wrap: wrap; gap: .8rem; }
  .scope { background: var(--night-2); border: 1px solid var(--night-line); border-radius: var(--r-tile); padding: 1.5rem; }
  .scope h2 { font-size: 1.05rem; font-stretch: 110%; margin-bottom: .6rem; }
  .scope ul { list-style: none; padding: 0; }
  .scope li { display: flex; gap: .75rem; align-items: baseline; padding: .65rem 0; border-top: 1px solid var(--night-line); font-size: .98rem; }
  .pbullets { list-style: none; padding: 0; display: grid; grid-template-columns: repeat(3, 1fr); margin-top: clamp(2.5rem, 5vw, 4rem); border-top: 1px solid var(--night-line); }
  .pbullets li { padding: 1.25rem 1rem 1.5rem 0; color: var(--on-night); font-weight: 550; }
  .pbullets li + li { padding-left: 1.25rem; border-left: 1px solid var(--night-line); }
  .deeper .head { max-width: 72ch; }
  .deeper-cards { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
  .deeper-cards article { background: #fff; border: 1px solid var(--paper-line); border-radius: var(--r-tile); padding: 1.75rem; display: grid; gap: .7rem; align-content: start; }
  .deeper-cards p, .deeper-cards li { color: var(--ink-muted); }
  .deeper-cards ul { padding-left: 1.1rem; }
  .faq-grid { display: grid; grid-template-columns: minmax(0, .8fr) minmax(0, 1.2fr); gap: clamp(2rem, 5vw, 4rem); }
  .faq-grid h2 { font-size: var(--step-3); }
  .related-band { padding-bottom: clamp(4rem, 8vw, 6rem); }
  .rel-h { font-size: 1.1rem; font-stretch: 110%; margin-bottom: 1rem; }
  .rel { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; }
  .rel a { display: grid; gap: .4rem; padding: 1.25rem 1.4rem; background: #fff; border: 1px solid var(--paper-line); border-radius: var(--r-tile); text-decoration: none; }
  .rel a:hover { border-color: var(--ink); }
  .rel a:hover strong { text-decoration: underline; text-underline-offset: 4px; }
  .rel span { color: var(--ink-muted); font-size: .95rem; }
  @media (max-width: 980px) {
    .phero-grid, .faq-grid { grid-template-columns: 1fr; }
    .deeper-cards, .rel { grid-template-columns: 1fr; }
    .pbullets { grid-template-columns: 1fr; }
    .pbullets li + li { padding-left: 0; border-left: 0; border-top: 1px solid var(--night-line); }
    .pbullets li { padding: .9rem 0; }
  }
</style>
