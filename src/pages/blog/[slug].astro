---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Contact from '../../components/Contact.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}
const { post } = Astro.props;
const { Content } = await render(post);
const url = `https://ideja-it.hr/blog/${post.id}/`;
const fmt = (d: Date) => d.toLocaleDateString('hr-HR', { day: 'numeric', month: 'long', year: 'numeric' });
const schema = [
  {
    '@type': 'BlogPosting', '@id': `${url}#post`, headline: post.data.title, description: post.data.description,
    datePublished: post.data.pubDate.toISOString(), dateModified: (post.data.updatedDate ?? post.data.pubDate).toISOString(),
    inLanguage: 'hr', mainEntityOfPage: url, keywords: post.data.tags.join(', '),
    author: { '@type': 'Person', name: 'Dorian Šutić' }, publisher: { '@id': 'https://ideja-it.hr/#business' },
    image: 'https://ideja-it.hr/images/og-image.jpg',
  },
  { '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Početna', item: 'https://ideja-it.hr/' },
    { '@type': 'ListItem', position: 2, name: 'Blog', item: 'https://ideja-it.hr/blog/' },
    { '@type': 'ListItem', position: 3, name: post.data.title, item: url },
  ] },
];
---
<Base title={`${post.data.title} | IDEJA IT`} ogTitle={post.data.title} ogType="article" description={post.data.description} schema={schema}>
  <article>
    <header class="night art-hero">
      <div class="wrap art-head">
        <nav class="crumbs" aria-label="Putanja"><a href="/">Početna</a><span aria-hidden="true">/</span><a href="/blog/">Blog</a></nav>
        <h1 class="display">{post.data.title}</h1>
        <p class="meta">
          <span>Dorian Šutić</span>
          <time datetime={post.data.pubDate.toISOString()}>{fmt(post.data.pubDate)}</time>
          {post.data.readingTime && <span>{post.data.readingTime} min čitanja</span>}
        </p>
      </div>
    </header>
    <div class="paper band">
      <div class="wrap">
        <div class="prose"><Content /></div>
      </div>
    </div>
  </article>
  <Contact heading="Trebate pomoć s ovom temom?" text="Javite nam što koristite i gdje zapinje, a mi ćemo predložiti sljedeći korak." subject={`Upit nakon članka: ${post.data.title}`} />
</Base>
<style>
  .art-hero { padding-block: clamp(3rem, 7vw, 5rem); }
  .art-head { display: grid; gap: 1.25rem; }
  .art-head h1 { font-size: clamp(2rem, 1.3rem + 2.8vw, 3.3rem); max-width: 24ch; }
  .crumbs { display: flex; gap: .5rem; font-size: .9rem; color: var(--on-night-muted); }
  .crumbs a { color: var(--on-night-muted); text-underline-offset: 3px; }
  .meta { display: flex; flex-wrap: wrap; gap: .4rem 1.5rem; color: var(--on-night-muted); font-size: .95rem; }
  .prose { font-size: 1.08rem; line-height: 1.7; }
</style>
