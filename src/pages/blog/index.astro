---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort((a, b) => +b.data.pubDate - +a.data.pubDate);
const fmt = (d: Date) => d.toLocaleDateString('hr-HR', { day: 'numeric', month: 'long', year: 'numeric' });
---
<Base
  title="Blog o IT-u, sigurnosti i eRačunu za tvrtke | IDEJA IT"
  description="Praktični članci o Microsoft 365, sigurnosti, NIS2, fiskalizaciji i eRačunu te IT-u za male i srednje tvrtke i knjigovodstvene urede."
  schema={[{ '@type': 'Blog', '@id': 'https://ideja-it.hr/blog/#blog', url: 'https://ideja-it.hr/blog/', name: 'IDEJA IT blog', inLanguage: 'hr', publisher: { '@id': 'https://ideja-it.hr/#business' } }]}
>
  <section class="night bl-hero">
    <div class="wrap">
      <h1 class="display">Blog</h1>
      <p class="lede muted">Praktično o IT-u, sigurnosti i propisima koji se tiču tvrtki i knjigovodstvenih ureda. Bez općenitih savjeta, s izvorima.</p>
    </div>
  </section>
  <section class="paper band">
    <div class="wrap">
      <ul class="list">
        {posts.map((p) => (
          <li>
            <a href={`/blog/${p.id}/`}>
              <time datetime={p.data.pubDate.toISOString()}>{fmt(p.data.pubDate)}</time>
              <h2>{p.data.title}</h2>
              <p>{p.data.description}</p>
              {p.data.readingTime && <span class="rt">{p.data.readingTime} min čitanja</span>}
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>
</Base>
<style>
  .bl-hero { padding-block: clamp(3rem, 7vw, 5rem); }
  .bl-hero h1 { font-size: var(--step-4); margin-bottom: 1rem; }
  .list { list-style: none; padding: 0; max-width: 900px; }
  .list li { border-top: 1px solid var(--paper-line); }
  .list li:last-child { border-bottom: 1px solid var(--paper-line); }
  .list a { display: grid; grid-template-columns: 11rem 1fr; column-gap: 2rem; row-gap: .5rem; padding: 2rem 0; text-decoration: none; }
  .list time { grid-row: span 3; color: var(--ink-muted); font-size: .95rem; padding-top: .3rem; }
  .list h2 { font-size: var(--step-2); font-stretch: 110%; }
  .list a:hover h2 { text-decoration: underline; text-underline-offset: 5px; }
  .list p { color: var(--ink-muted); max-width: 64ch; }
  .rt { font-size: .88rem; color: var(--ink-muted); }
  @media (max-width: 700px) { .list a { grid-template-columns: 1fr; } .list time { grid-row: auto; } }
</style>
