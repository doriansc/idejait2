---
import { site, mailto } from '../data/site';
---
<div class="fab" role="group" aria-label="Brzi kontakt">
  <a class="fab-call" href={`tel:${site.phone}`}>
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2"/></svg>
    Nazovite
  </a>
  <a class="fab-ic fab-wa" href={site.whatsapp} aria-label="Pošaljite WhatsApp poruku">
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20.5 12a8.5 8.5 0 0 1-12.3 7.6L3.5 21l1.4-4.5A8.5 8.5 0 1 1 20.5 12Z"/></svg>
  </a>
  <a class="fab-ic" href={mailto()} aria-label="Pošaljite email">
    <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg>
  </a>
</div>
<style>
  .fab { display: none; }
  @media (max-width: 720px) {
    .fab {
      position: fixed; left: .75rem; right: .75rem; bottom: calc(.75rem + env(safe-area-inset-bottom, 0px)); z-index: 90;
      display: flex; gap: .5rem; padding: .5rem; border-radius: 12px;
      background: rgba(14, 24, 35, .96); border: 1px solid var(--night-line); box-shadow: 0 10px 30px rgba(0, 0, 0, .35);
    }
    .fab a { display: inline-flex; align-items: center; justify-content: center; gap: .5rem; min-height: 48px; border-radius: 8px; text-decoration: none; color: #fff; font-weight: 700; }
    .fab-call { flex: 1; background: var(--signal-btn); }
    .fab-ic { width: 52px; background: var(--night-3); }
    .fab-wa { background: #1f9d55; }
    .fab svg { width: 20px; height: 20px; fill: none; stroke: currentColor; stroke-width: 1.9; stroke-linecap: round; stroke-linejoin: round; }
    :global(body) { padding-bottom: 5.5rem; }
  }
</style>
