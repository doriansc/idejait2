---
import Wordmark from './Wordmark.astro';
import { site } from '../data/site';
import { services } from '../data/services';
const year = new Date().getFullYear();
---
<footer class="foot night">
  <div class="wrap foot-grid">
    <div class="foot-id">
      <Wordmark />
      <p class="muted">IT podrška, sigurnost i automatizacija za tvrtke i knjigovodstvene urede u Zagrebu i okolici.</p>
      <address>
        {site.street}, {site.postalCode} {site.city}<br />
        <a href={`tel:${site.phone}`}>{site.phoneDisplay}</a><br />
        <a href={`mailto:${site.email}`}>{site.email}</a>
      </address>
    </div>
    <nav aria-label="Usluge">
      <h2>Usluge</h2>
      <ul>{services.map((s) => <li><a href={`/${s.slug}/`}>{s.tile.name}</a></li>)}</ul>
    </nav>
    <nav aria-label="Ostalo">
      <h2>Korisno</h2>
      <ul>
        <li><a href="/samoprocjena/">Sigurnosna samoprocjena</a></li>
        <li><a href="/blog/">Blog</a></li>
        <li><a href="/#slucajevi">Tipični slučajevi</a></li>
        <li><a href="/#kontakt">Kontakt</a></li>
      </ul>
    </nav>
  </div>
  <div class="wrap foot-bottom">
    <span>© {year} {site.legalName}</span>
    <span><a href="/privatnost/">Privatnost</a><a href="/impressum/">Podaci o pružatelju usluge</a></span>
  </div>
</footer>
<style>
  .foot { padding-top: 4rem; border-top: 1px solid var(--night-line); }
  .foot-grid { display: grid; grid-template-columns: 1.4fr 1fr 1fr; gap: 2.5rem; }
  .foot-id { display: grid; gap: 1rem; align-content: start; max-width: 36ch; }
  address { font-style: normal; color: var(--on-night-muted); line-height: 1.8; }
  .foot a { text-decoration: none; }
  .foot a:hover { color: var(--signal); }
  .foot h2 { font-size: .95rem; margin-bottom: .9rem; }
  .foot ul { list-style: none; padding: 0; display: grid; gap: .5rem; color: var(--on-night-muted); }
  .foot-bottom { display: flex; justify-content: space-between; flex-wrap: wrap; gap: 1rem; margin-top: 3rem; padding-block: 1.5rem; border-top: 1px solid var(--night-line); font-size: .88rem; color: var(--on-night-muted); }
  .foot-bottom span:last-child { display: flex; gap: 1.5rem; }
  @media (max-width: 820px) { .foot-grid { grid-template-columns: 1fr 1fr; } .foot-id { grid-column: 1 / -1; } }
  @media (max-width: 480px) { .foot-grid { grid-template-columns: 1fr; } }
</style>
