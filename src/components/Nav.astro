---
import Wordmark from './Wordmark.astro';
import { nav, site } from '../data/site';
---
<header class="nav night">
  <div class="nav-in wrap">
    <a href="/" class="nav-home" aria-label="IDEJA IT, početna"><Wordmark /></a>
    <nav aria-label="Glavna navigacija" id="nav-menu" class="nav-menu">
      <ul>
        {nav.map((n) => <li><a href={n.href}>{n.label}</a></li>)}
      </ul>
      <div class="nav-actions">
        <a class="nav-phone" href={`tel:${site.phone}`}>{site.phoneDisplay}</a>
        <a class="btn btn-signal nav-cta" href="/#kontakt">Pošaljite upit</a>
      </div>
    </nav>
    <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="nav-menu">
      <span class="sr-only">Izbornik</span>
      <span class="bars" aria-hidden="true"></span>
    </button>
  </div>
</header>
<script>
  const btn = document.querySelector<HTMLButtonElement>('.nav-toggle');
  const menu = document.getElementById('nav-menu');
  if (btn && menu) {
    const set = (open: boolean) => {
      btn.setAttribute('aria-expanded', String(open));
      menu.classList.toggle('open', open);
      document.body.classList.toggle('menu-open', open);
    };
    btn.addEventListener('click', () => set(btn.getAttribute('aria-expanded') !== 'true'));
    menu.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => set(false)));
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape') set(false); });
  }
</script>
<style>
  .nav { position: sticky; top: 0; z-index: 100; border-bottom: 1px solid var(--night-line); background: rgba(14, 24, 35, .94); backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px); }
  .nav-in { height: var(--nav-h); display: flex; align-items: center; justify-content: space-between; gap: 2rem; }
  .nav-home { text-decoration: none; }
  .nav-menu { display: flex; align-items: center; gap: 2rem; }
  .nav-menu ul { display: flex; gap: 1.6rem; list-style: none; padding: 0; }
  .nav-menu ul a { text-decoration: none; color: var(--on-night-muted); font-weight: 550; font-size: .98rem; }
  .nav-menu ul a:hover { color: var(--on-night); }
  .nav-actions { display: flex; align-items: center; gap: 1.2rem; }
  .nav-phone { font-family: var(--mono); font-size: .92rem; color: var(--on-night); text-decoration: none; white-space: nowrap; }
  .nav-phone:hover { color: var(--signal); }
  .nav-cta { min-height: 40px; padding: .5rem 1rem; font-size: .95rem; }
  .nav-toggle { display: none; background: none; border: 1px solid var(--night-line); border-radius: var(--r-ctl); width: 46px; height: 42px; color: var(--on-night); cursor: pointer; }
  .bars, .bars::before, .bars::after { display: block; width: 20px; height: 2px; background: currentColor; margin: auto; position: relative; transition: transform .2s, background-color .2s; }
  .bars::before, .bars::after { content: ''; position: absolute; left: 0; }
  .bars::before { top: -6px; } .bars::after { top: 6px; }
  [aria-expanded='true'] .bars { background: transparent; }
  [aria-expanded='true'] .bars::before { transform: translateY(6px) rotate(45deg); }
  [aria-expanded='true'] .bars::after { transform: translateY(-6px) rotate(-45deg); }

  @media (max-width: 980px) {
    .nav-toggle { display: block; }
    .nav-menu {
      display: none; position: fixed; inset: var(--nav-h) 0 0 0; background: var(--night);
      flex-direction: column; align-items: stretch; gap: 0; padding: 1rem var(--gutter) 2rem; overflow-y: auto;
    }
    .nav-menu.open { display: flex; }
    .nav-menu ul { flex-direction: column; gap: 0; }
    .nav-menu ul a { display: block; padding: 1rem 0; border-bottom: 1px solid var(--night-line); font-size: 1.25rem; font-stretch: 112%; color: var(--on-night); }
    .nav-actions { flex-direction: column; align-items: stretch; gap: .8rem; margin-top: 1.5rem; }
    .nav-phone { font-size: 1.3rem; padding: .5rem 0; }
    .nav-cta { min-height: 52px; font-size: 1.05rem; }
  }
</style>
<style is:global>body.menu-open { overflow: hidden; }</style>
